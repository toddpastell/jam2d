{
  "name": "jam2d",
  "version": "0.1.0",
  "description": "A tiny, dependency-free pixel game engine for game jams.",
  "keywords": [
    "game",
    "engine",
    "pixel",
    "2d",
    "webgl",
    "gamejam"
  ],
  "homepage": "https://github.com/toddpastell/jam2d#readme",
  "bugs": "https://github.com/toddpastell/jam2d/issues",
  "repository": "github:toddpastell/jam2d",
  "license": "MIT",
  "author": "toddpastell",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "dev": "vite",
    "prepublishOnly": "pnpm build",
    "sort": "sort-package-json",
    "typecheck": "tsc"
  },
  "devDependencies": {
    "sort-package-json": "^4.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "packageManager": "pnpm@12.5.1",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.5.1",
      "onFail": "download"
    }
  }
}
